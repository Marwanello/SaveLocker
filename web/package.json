{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "mockups": "vite --config mockup-features/vite.config.ts",
    "mockups:build": "vite build --config mockup-features/vite.config.ts && node ../agent-ui/mockup-features/inline.cjs .mockup-features-dist ../mockups/console.html",
    "gen:api": "openapi-typescript ../src/Server/openapi.json -o src/api-types.ts",
    "lint": "oxlint",
    "export:art": "node scripts/export-art.mjs",
    "icons:build": "node scripts/build-platform-icons.mjs",
    "icons:check": "node scripts/build-platform-icons.mjs --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.69.0",
    "svgpath": "^2.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0"
  }
}
