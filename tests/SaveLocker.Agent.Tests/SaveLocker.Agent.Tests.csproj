<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one xUnit project on the Windows-agent side (tasks/playnite-plugin/plan.md, Phase 18).
       Every other Windows-agent test is a PowerShell script driving real processes (run-winagent-
       tests.ps1 etc.) — this exists because PlayniteLibrary's LiteDB fixture is cheap to build
       in-process, unlike HeroicLibrary's real Electron JSON files, which is genuinely a different
       situation, not a change of testing philosophy for the rest of this project. -->

  <PropertyGroup>
    <!-- Matches SaveLocker.Agent: a project cannot reference one built for a newer platform version. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Agent\SaveLocker.Agent.csproj" />
  </ItemGroup>

  <!-- SvgPath is pure (no ImGui), so its source is linked in rather than referencing the Linux agent
       project, whose SDL/GL dependencies have no business in a Windows-agent test assembly. -->
  <ItemGroup>
    <Compile Include="..\..\src\Agent.Linux\Ui\SvgPath.cs" Link="SvgPath.cs" />
    <!-- Same reason: the launcher's choice of program is pure, only its probing touches the machine. -->
    <Compile Include="..\..\src\Agent.Linux\AppWindowPlan.cs" Link="AppWindowPlan.cs" />
    <!-- The Steam art compositor is pure too: layers in, PNG out. -->
    <Compile Include="..\..\src\Agent.Linux\Art\SteamArtRenderer.cs" Link="SteamArtRenderer.cs" />
    <Compile Include="..\..\src\Agent.Linux\Art\SteamArt.cs" Link="SteamArt.cs" />
    <!-- And the menu entry: plain file I/O, with the template it renders embedded under the same name. -->
    <Compile Include="..\..\src\Agent.Linux\DesktopEntry.cs" Link="DesktopEntry.cs" />
    <EmbeddedResource Include="..\..\packaging\linux\savelocker.desktop"
                      LogicalName="SaveLocker.Agent.Linux.savelocker.desktop" />
  </ItemGroup>

</Project>
