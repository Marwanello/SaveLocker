<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SaveLocker.Agent.Linux</RootNamespace>
    <!-- The command users type, and what the Steam launch-options wrapper is called. -->
    <AssemblyName>savelocker</AssemblyName>
    <!-- The Game Mode UI copies the launch command to the system clipboard via SDL (byte*). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- SteamOS ships no .NET runtime, so releases must be published self-contained for
         linux-x64 (see packaging/linux/build-linux.sh). Deliberately not pinned here, so the
         project still builds and tests RID-agnostically on any dev box. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- This assembly is Linux-only in fact — /proc, systemctl, ~/.local, Proton prefixes — but the
       TFM is deliberately RID-agnostic so it builds on any dev box. Saying so explicitly is what
       lets the platform-compatibility analyzer accept File.SetUnixFileMode and friends, instead of
       every Unix call site needing an OperatingSystem.IsWindows() guard that could never be true. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatform">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agent.Core\SaveLocker.Agent.Core.csproj" />
    <ProjectReference Include="..\Shared\SaveLocker.Shared.csproj" />
  </ItemGroup>

  <!-- Inter + JetBrains Mono, the same faces the console and the React agent UI use, so all three
       surfaces share a typeface as well as a palette. Embedded rather than shipped loose: no
       install.sh change, no path resolution, and a dev build behaves like an installed one.
       Both are SIL OFL 1.1 — the licence files sit alongside and must stay with them.
       ~1.05 MB. Subsetting to Latin would cut that to ~180 KB; not done yet, see the task file. -->
  <ItemGroup>
    <EmbeddedResource Include="Ui\Fonts\Inter-Regular.ttf" />
    <EmbeddedResource Include="Ui\Fonts\Inter-SemiBold.ttf" />
    <EmbeddedResource Include="Ui\Fonts\JetBrainsMono-Regular.ttf" />
  </ItemGroup>

  <!-- THE systemd unit. Embedded from packaging/ rather than duplicated in C#, because this file
       has two writers — install.sh drops the packaged copy, and `savelocker autostart` writes one
       itself — and they had already drifted. Now they emit the same text, with only the executable
       path substituted, so the hardening directives and the update hook cannot exist in one and not
       the other. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\packaging\linux\savelocker.service"
                      LogicalName="SaveLocker.Agent.Linux.savelocker.service" />
  </ItemGroup>

  <!-- UI-sized re-export of the Steam artwork. Linked from packaging/ rather than copied so there
       is one master: the full-size dist/ assets are ~2.1 MB and are for the Steam library, not the
       UI. Must stay 8-bit RGBA, non-interlaced — that is all Ui/Art.cs decodes. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\packaging\linux\artwork\dist\ui\logo-96.png"
                      LogicalName="SaveLocker.Agent.Linux.Ui.Art.logo-96.png" />
  </ItemGroup>

  <!-- Game Mode UI (`savelocker ui`, Phase 3). SDL windowing + OpenGL + Dear ImGui via Silk.NET.
       SDL is prioritised so the window is a gamescope-native client and Steam Input can deliver a
       gamepad (Linux-Agent-Streamline.md §3). Native libs (SDL, cimgui) load on demand, so
       `savelocker daemon` on a headless box never touches SDL or a GPU. -->
  <ItemGroup>
    <PackageReference Include="Silk.NET.Windowing.Sdl" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Input.Sdl" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenGL.Extensions.ImGui" Version="2.22.0" />
  </ItemGroup>

  <!-- The daemon serves the same React agent UI as the tray (Decisions.md §2): it is the
       only UI a headless Deck has. Copy it next to the binary so AgentApiServer can serve it. -->
  <Target Name="CopyAgentUiDist" AfterTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)..\..\agent-ui\dist')">
    <ItemGroup>
      <AgentUiDistFiles Include="$(MSBuildThisFileDirectory)..\..\agent-ui\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AgentUiDistFiles)" DestinationFolder="$(OutputPath)agent-ui\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyAgentUiDistOnPublish" AfterTargets="Publish" Condition="Exists('$(MSBuildThisFileDirectory)..\..\agent-ui\dist')">
    <ItemGroup>
      <AgentUiDistFilesForPublish Include="$(MSBuildThisFileDirectory)..\..\agent-ui\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AgentUiDistFilesForPublish)" DestinationFolder="$(PublishDir)agent-ui\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
