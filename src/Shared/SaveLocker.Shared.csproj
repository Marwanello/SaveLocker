<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenApiSchemaSorterMiddleware (OpenApiSchemaSorter.cs) is ASP.NET Core middleware, shared
         between the Server and Agent.Core hosts — both already carry this FrameworkReference
         themselves, so this adds nothing new to their published output. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="YamlDotNet" Version="18.0.0" />
  </ItemGroup>

</Project>
